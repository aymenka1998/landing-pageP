# Optional: Google Apps Script Web App URL for storing orders in Google Sheets.
# Leave blank if you only want customers to submit their order through WhatsApp.
GOOGLE_SHEET_WEBHOOK=

# Public Supabase settings used to read the published product configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
PRODUCT_CONFIG_SOURCE=supabase
